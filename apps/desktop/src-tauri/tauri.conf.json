{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SenstoSales",
  "version": "0.1.0",
  "identifier": "app.senstosales.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "shell", "url": "index.html", "title": "SenstoSales", "visible": false }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/sensto-sidecar"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "installer-hooks.nsh" }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERUEzMERERjUwRjYxMjYKUldRbVlRLzEzVERxVFhIWHp4aW40MFphbHpGOVd4R1J1ZzF3WGpVUng3WU95ZTRlVmVDTEpsYVQK",
      "endpoints": ["https://github.com/Cube-27/Senstosales/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
