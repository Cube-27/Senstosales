{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SenstoSpike",
  "version": "0.0.1",
  "identifier": "test.sensto.spike",
  "build": { "frontendDist": "../ui/dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Sensto spike", "width": 1000, "height": 700 }],
    "security": { "csp": null }
